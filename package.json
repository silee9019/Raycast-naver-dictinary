{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "search-naver-english-dictionary",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.0.0"
  },
  "title": "네이버 다국어 사전",
  "description": "Raycast에서 네이버 영한·국어·스페인어-한국어 사전 검색",
  "icon": "command-icon.png",
  "keywords": [
    "naver",
    "dict",
    "dictionary",
    "사전",
    "영어",
    "english",
    "번역",
    "국어",
    "korean",
    "spanish",
    "español"
  ],
  "author": "gunflake09",
  "categories": [
    "Applications"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "영한 사전 검색",
      "description": "네이버 영한 사전에서 단어 검색",
      "mode": "view",
      "keywords": [
        "naver",
        "dict",
        "dictionary",
        "사전",
        "영어",
        "english",
        "번역"
      ]
    },
    {
      "name": "korean",
      "title": "국어 사전 검색",
      "description": "네이버 국어 사전에서 단어 검색",
      "mode": "view",
      "keywords": [
        "naver",
        "dict",
        "dictionary",
        "사전",
        "국어",
        "korean",
        "한국어"
      ]
    },
    {
      "name": "spanish",
      "title": "스페인어-한국어 사전 검색",
      "description": "네이버 스페인어-한국어 사전에서 단어 검색",
      "mode": "view",
      "keywords": [
        "naver",
        "dict",
        "dictionary",
        "사전",
        "스페인어",
        "spanish",
        "español",
        "한국어"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.57.1",
    "axios": "^1.16.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "1.0.5",
    "@types/node": "18.8.3",
    "@types/react": "18.0.9",
    "eslint": "^7.32.0",
    "prettier": "^2.8.8",
    "typescript": "^4.4.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "install-extension": "ray build -e dist && open \"raycast://extensions/install?path=$(pwd)\"",
    "lint": "ray lint",
    "test": "node --test tests/dictionaries.test.cjs",
    "publish": "pnpm dlx @raycast/api@latest publish"
  },
  "pnpm": {
    "overrides": {
      "follow-redirects": "1.16.0",
      "minimatch": "9.0.9",
      "brace-expansion": "2.0.3",
      "picomatch": "4.0.4",
      "flatted": "3.4.2",
      "fast-uri": "3.1.2",
      "esbuild": "0.28.1",
      "ajv@6": "6.14.0",
      "ajv@8": "8.20.0"
    }
  }
}
